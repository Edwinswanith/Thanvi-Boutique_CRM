# MongoDB Atlas (replica set required for transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=thanvi_boutique
# openssl rand -base64 32
AUTH_SECRET=
# Opt in to simulated checkout when running a production build in a test environment.
ENABLE_TEST_CHECKOUT=false
# Test checkout delivery charge before GST, in paise, and its test GST rate in percent.
SHOP_TEST_SHIPPING_PAISE=0
SHOP_TEST_SHIPPING_GST_RATE=0
# Public storefront address — used for canonical URLs, sitemap, structured data and llms.txt
NEXT_PUBLIC_SITE_URL=https://thanviboutique.com
# Seed: initial Super Admin + Owner logins (set before `npm run seed`)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
# Optional: shared password for the sample logins created by `npm run seed:demo`
# (demo-owner@thanvi.test, demo-head@, demo-store@, demo-web@, demo-sales@, demo-godown@, demo-content@)
SEED_DEMO_PASSWORD=
# Later phases
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
